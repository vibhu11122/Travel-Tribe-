# ============================================================
# Travel Tribe — Environment Configuration Example
# Copy this file to .env.local for local development
# ============================================================

# ── Application URLs ─────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase Database & Auth ──────────────────────────────────
# Find these in your Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Meta WhatsApp Business Cloud API ─────────────────────────
# 1. Public WhatsApp number used for Click-to-Chat buttons (Country code + digits, no '+' or spaces)
NEXT_PUBLIC_WHATSAPP_PHONE_NUMBER=919599233810

# 2. Meta WhatsApp Cloud API credentials (From Meta Developers Portal -> WhatsApp -> API Setup)
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_BUSINESS_ACCOUNT_ID=987654321098765
WHATSAPP_ACCESS_TOKEN=EAAG...your_permanent_system_user_access_token_here

# 3. Webhook verification & security
# Set this secret to match your Meta App Secret (App Dashboard -> Basic Settings -> App Secret)
WHATSAPP_APP_SECRET=your_meta_app_secret_here

# Set this to any secure random string challenge matching Meta Webhook configuration
WHATSAPP_VERIFY_TOKEN=travel_tribe_verify_token_2026

# Set to 'true' or 'false' to enable/disable automated warm replies to inbound WhatsApp inquiries
WHATSAPP_AUTO_REPLY=true

# ── Razorpay Payment Gateway (Optional / Future) ─────────────
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...
